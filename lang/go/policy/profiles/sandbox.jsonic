{
  version: 1
  name:    "sandbox"

  limits: {
    timeoutMs:      5000
    maxStepBudget:  1000000
    maxStackDepth:  256
    maxOutputBytes: 65536
  }

  scopes: {
    global: {
      words: {
        default: "deny"
        rules: [
          { allow: ["disk.read", "clock", "mutate"] }
          { deny:  ["disk.write", "network", "process",
                    "env", "system-info"] }
        ]
      }
    }

    engine: {
      words: { default: "allow" }
    }

    modules: {
      words: {
        default: "deny"
        rules: [
          { allow: ["import"], where: { module: ["boru:math-util", "boru:time-util", "boru:io", "boru:cli"] } }
          // A boru-SOURCE module (`import "./lib.boru"`) runs under this
          // same profile — its body inherits the importer's policy — so
          // admitting the import widens nothing its body could do. Reading
          // the file is still the fileops scope's call (NUR079).
          { allow: ["import"], where: { kind: ["file"] } }
        ]
      }
      scopes: {
        "boru:math-util": { words: { default: "allow" } }
        "boru:time-util": {
          words: {
            default: "allow"
            rules: [{ deny: ["sleep"] }]
          }
        }
        // Importing boru:io grants the module's words (streams,
        // printstr) — NOT disk access. File ops are gated by BOTH the
        // global disk.* caps above AND the fileops scope below, and
        // either gate can deny alone: sandbox's fileops default is
        // deny with no rules, so sandbox denies file reads AND writes
        // even though disk.read is globally allowed. Profiles that
        // mean "reads work" (read-only, client) add explicit
        // fileops allow rules.
        "boru:io": { words: { default: "allow" } }
        // boru:cli is PURE — a spec map and an argument vector in, a decision
        // map out — so a sandboxed program may parse its own command line.
        // Without it a sandboxed tool can read IO.args and not interpret them.
        "boru:cli": { words: { default: "allow" } }
      }
    }

    fileops: {
      words: {
        default: "deny"
        rules: []
      }
    }

    network: { install: false }
    sqlite:  { install: false }
    process: { install: false }
    terminal: { install: false }
    vault:   { install: false }

    formats: { words: { default: "allow" } }
    env:     { words: { default: "deny" } }
    clock:   { words: { default: "allow" } }
  }
}
