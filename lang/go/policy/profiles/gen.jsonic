{
  version: 1
  name:    "gen"

  # BORU-G: the generator profile. Used by boru:test property-based
  # testing to evaluate generator programs and shrink candidates
  # safely. Permits math, randomness, and decision-table evaluation
  # only — no clock, no IO, no network, no process, no env. Local
  # def/mutate inside generator bodies is allowed (so generators can
  # use temporaries).
  #
  # The reducer re-evaluates a generator program ~10²-10³ times
  # during candidate exploration, so maxStepBudget is tighter than
  # compute.jsonic — each evaluation must terminate quickly.

  limits: {
    timeoutMs:      5000
    maxStepBudget:  200000
    maxStackDepth:  256
  }

  scopes: {
    global: {
      words: {
        default: "deny"
        rules: [
          { allow: ["mutate"] }
        ]
      }
    }

    engine: {
      words: { default: "allow" }
    }

    modules: {
      words: {
        default: "deny"
        rules: [
          { allow: ["import"], where: {
              module: ["boru:math-util", "boru:rand", "boru:decision", "boru:test"]
          } }
          // A boru-SOURCE module (`import "./lib.boru"`) runs under this
          // same profile — its body inherits the importer's policy — so
          // admitting the import widens nothing its body could do. Reading
          // the file is still the fileops scope's call (NUR079).
          { allow: ["import"], where: { kind: ["file"] } }
        ]
      }
      scopes: {
        "boru:math-util": { words: { default: "allow" } }
        "boru:rand":     { words: { default: "allow" } }
        "boru:decision": { words: { default: "allow" } }
        "boru:test":     { words: { default: "allow" } }
      }
    }

    fileops: { install: false }
    network: { install: false }
    sqlite:  { install: false }
    process: { install: false }
    env:     { install: false }
    terminal: { install: false }
    vault:   { install: false }
    formats: { words: { default: "allow" } }
    clock:   { install: false }
  }
}
