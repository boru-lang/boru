=== BEHAVIOR ===
CASE add-forward
  add 2 3
  => "5"
CASE sub-swap
  10 sub 3
  => "7"
CASE sub-forward
  sub 10 3
  => "-7"
CASE mul-stack
  4 5 mul
  => "20"
CASE nested-arith
  add (mul 2 3) (sub 10 4)
  => "0"
CASE if-then
  if true 99 88 end
  => "99"
CASE if-else
  if false 99 88 end
  => "88"
CASE if-listcond-then
  if [1 gt 0] 99 88 end
  => "99"
CASE if-listcond-else
  if [1 lt 0] 99 88 end
  => "88"
CASE if-no-else-true
  if true 99 end
  => "99"
CASE if-no-else-false
  if false 99 end
  => ""
CASE if-clauselist
  if [false "a" true "b" "c"]
  => "'b'"
CASE if-bodyeval
  if true [1 add 2] [10 add 20] end
  => "3"
CASE named-fn-simple
  def dbl fn [[n:Integer] [Integer] [n mul 2]]  dbl 21
  => "42"
CASE named-fn-forward
  def f fn [[a:Integer b:Integer] [Integer] [a sub b]]  f 10 3
  => "7"
CASE named-fn-recursive
  def fact fn [[n:Integer] [Integer] [if (n lte 1) [1] [n mul (fact (n sub 1))]]]  fact 5
  => "120"
CASE named-fn-multi-overload
  def g fn [[a:Integer] [Integer] [a add 1] [a:String] [String] [a]]  g 41
  => "42"
CASE afn-direct
  ([n:Integer] => [n add 1]) 41
  => "fn (Integer) 41"
CASE closure-adder
  def make-adder ([x:Integer] => [([y:Integer] => [x add y])])  def add5 (make-adder 5)  add5 3
  => "8"
CASE closure-reuse
  def make-adder ([x:Integer] => [([y:Integer] => [x add y])])  def add5 (make-adder 5)  add5 3  add5 10
  => "8 15"
CASE each-double
  [1 2 3] each [dup add]
  => "[2 4 6]"
CASE fold-sum
  fold [add] [1 2 3 4]
  => "10"
CASE fold-init
  10 fold [add] [1 2 3 4]
  => "20"
CASE dup
  5 dup add
  => "10"
CASE swap
  1 2 swap sub
  => "1"
CASE drop
  1 2 3 drop
  => "1 2"

=== CHECK MODE ===
CHECK check-named-fn-int
  def dbl fn [[n:Integer] [Integer] [n mul 2]]  dbl 21
  => "Scalar/Number/Integer"
CHECK check-named-fn-untyped
  def idf fn [[n:Integer] [Integer] [n]]  idf 7
  => "Scalar/Number/Integer"
CHECK check-afn-direct
  ([n:Integer] => [n add 1]) 41
  => "Type/Function Scalar/Number/Integer"
CHECK check-closure
  def mk ([x:Integer] => [([y:Integer] => [x add y])])  def a5 (mk 5)  a5 3
  => "Scalar/Number/Integer"
CHECK check-if-branches
  if (1 gt 0) [10] [20] end
  => "Scalar/Number/Integer diagnostics=[unreachable_branch]"
CHECK check-recursive
  def fact fn [[n:Integer] [Integer] [if (n lte 1) [1] [n mul (fact (n sub 1))]]]  fact 4
  => "Scalar/Number/Integer"
