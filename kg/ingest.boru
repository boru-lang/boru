# ingest.boru — turn candidate data into graph objects.
#
# The pipeline is source-agnostic: every input is reduced to a CANDIDATE
# BUNDLE first, and one function (ingest-bundle) turns candidate bundles
# into typed graph objects with deterministic ids.
#
# Candidate bundle shape (jsonic/JSON friendly — see fixtures/*.jsonic):
#   { sources:    [ {id? kind locator title? retrieved_at? content_hash?
#                    authority? metadata?} ]
#     entities:   [ {key type label aliases? external_ids? attributes?
#                    status?} ]
#     assertions: [ {subject predicate object evidence confidence?
#                    status? valid_from? valid_to? rule? recorded_at?} ] }
# where `key` is a caller-chosen candidate name — the SAME key + type +
# label in two bundles deliberately names the same entity (that is how a
# re-ingested or overlapping bundle stays stable); auto-generated keys
# (rows-to-candidates) are namespaced by source id so they can never
# collide by coincidence — an object is exactly
#   {kind:"entity" entity:<key-or-ent-id>}  or
#   {kind:"literal" value datatype unit? language?}
# and an evidence entry is {source locator quote? extraction_method?
# extractor?}.
#
# Candidate assertions proposed by a model or an agent use the SAME
# shape and the same checks — model output is never evidence; its
# evidence entries must point at the original source (validate.boru
# additionally requires a quote for text sources and flags model
# extractions without one).
#
# Tabular rows (CSV/TSV read via IO.read {fmt:'csv}/{fmt:'tsv}) are
# adapted with rows-to-candidates below. An existing boru-kg/1 bundle
# (the output contract) re-ingests via bundle-to-candidates.

import "boru:string-util"
import "boru:struct-util"
import "./util.boru"
import "./schema.boru"
import "./identifiers.boru"
import "./normalize.boru"
import "./entities.boru"
import "./assertions.boru"

def get-or KgUtil.get-or
def list-at KgUtil.list-at
def starts-with KgUtil.starts-with

# ---- sources ------------------------------------------------------------

# Complete a raw source map: derive content_hash and id when absent.
def ingest-source fn raw:Map Map [
  def locator (get-or raw "locator" "")
  def title (get-or raw "title" locator)
  def kind (get-or raw "kind" "json")
  def hash
    (get-or raw "content_hash"
        (KgId.fingerprint
            (KgId.canon-of {kind:kind locator:locator title:title})
        )
    )
  def id (get-or raw "id" (KgId.source-id locator hash))
    KgSchema.mk-source
    {id:id
      kind:kind
      locator:locator
      title:title
      retrieved_at:(get-or raw "retrieved_at" none)
      content_hash:hash
      authority:(get-or raw "authority" "unknown")
      metadata:(get-or raw "metadata" {})
    }
]

# ---- entities -----------------------------------------------------------

# Drop external-id schemes whose value is blank: an empty value can
# never identify anything, and two blanks must never count as a
# "matching identifier" during resolution (that would auto-merge
# unrelated entities at 0.98 confidence).
def prune-external-ids fn eids:Map Map [
  filter ([v] => [not ((convert String v) eq "")]) eids
]

# One candidate entity -> KgEntity with a deterministic id. A key that
# is already an ent: id (an existing bundle re-ingesting) is kept
# verbatim, so re-processing a graph preserves its identifiers.
def ingest-entity fn raw:Map Map [
  def etype (get-or raw "type" "Other")
  def label (KgNorm.norm-display (get-or raw "label" ""))
  def nlabel (KgNorm.norm-label label)
  def key (convert String (get-or raw "key" nlabel)) KgSchema.mk-entity
    {id:(if (starts-with "ent:" key) [key]
          [KgId.entity-id etype nlabel key]
      )
      type:etype
      label:label
      normalized_label:nlabel
      aliases:(KgEnt.distinct-sorted
          (each ([a] => [KgNorm.norm-display a])
              (get-or raw "aliases" [])
          )
      )
      external_ids:(prune-external-ids (get-or raw "external_ids" {}))
      attributes:(get-or raw "attributes" {})
      status:(get-or raw "status" "accepted")
    }
]

# ---- objects and evidence ----------------------------------------------

# Resolve a candidate object against the key->id map. An `entity` value
# that is not a known key passes through untouched when it is already an
# ent: id (cross-bundle references); anything else is left as-is for
# validate.boru to flag as dangling.
def ingest-object fn [[raw:Map keymap:Map] [Map] [
  def kind (get-or raw "kind" "")
  if (kind eq "entity")
    [def target (get-or raw "entity" "")
      def hit (keymap get target) KgSchema.mk-entity-ref
        (if (hit is None) [target] [hit])
    ]
    [KgSchema.mk-literal
        {value:(get-or raw "value" "")
          datatype:(get-or raw "datatype" "String")
          unit:(get-or raw "unit" none)
          language:(get-or raw "language" none)
        }
    ]
]]

def ingest-evidence fn raw:Map Map [
  KgSchema.mk-evidence
    {source_id:(get-or raw "source" (get-or raw "source_id" ""))
      locator:(get-or raw "locator" "")
      quote:(get-or raw "quote" none)
      extraction_method:(get-or raw "extraction_method" "direct_record")
      extractor:(get-or raw "extractor" "kg-ingest")
    }
]

# ---- the candidate-bundle ingester --------------------------------------

# ingest-bundle raw recorded_at -> {sources entities assertions issues}
#
# Entities with identical deterministic ids (the same record arriving
# twice) are unified: first occurrence wins, later labels/aliases fold
# into aliases, external_ids/attributes union with the FIRST occurrence
# winning on conflicts. Assertions whose subject key is unknown, or that
# carry no evidence, are rejected with an error issue; they are never
# emitted as dangling or unsupported claims.
def ingest-bundle fn [[raw:Map recorded_at:String] [Map] [
  def sources
    (each ([s] => [ingest-source s]) (get-or raw "sources" []))
  def raw-entities (get-or raw "entities" [])
  def folded
    (fold
        ([cand acc] => [
              def e (ingest-entity cand)
              def key (get-or cand "key" e.id)
              def keymap (get-or acc "keymap" {})
              def ents (list-at acc "entities")
              def issues (list-at acc "issues")
              def prev-id (keymap get key)
              if (not (prev-id is None))
                [def issue
                    (KgSchema.mk-issue
                        {id:(KgId.issue-id "kg_duplicate_key" key
                              `duplicate candidate key ${key}`
                          )
                          severity:"warning"
                          rule:"kg_duplicate_key"
                          target_kind:"entity"
                          target_id:key
                          message:`candidate entity key ${key} appears more than once; later entry folded into the first`
                          suggested_correction:none
                          automatic_correction_safe:false
                        }
                    )
                    KgUtil.as-map
                    {keymap:keymap
                      entities:ents
                      issues:(push issue issues)
                    }
                ]
                [def existing (filter [dot id eq e.id] ents)
                  if ((existing size) gt 0)
                    [def first (existing get 0)
                      def unified (KgEnt.merge-pair first e)
                      def kept
                        (each
                            ([x] => [
                                  if (x.id eq e.id)
                                    [unified get "winner"] [x]
                                ])
                            ents
                        )
                        KgUtil.as-map
                        {keymap:(keymap set (key) e.id)
                          entities:kept
                          issues:issues
                        }
                    ]
                    [KgUtil.as-map
                        {keymap:(keymap set (key) e.id)
                          entities:(push e ents)
                          issues:issues
                        }
                    ]
                ]
            ])
        raw-entities {keymap:{} entities:[] issues:[]}
    )
  def keymap (folded get "keymap")
  def ast-folded
    (fold
        ([cand acc] => [
              def asts (list-at acc "assertions")
              def issues (list-at acc "issues")
              def subj-key (get-or cand "subject" "")
              def subj-hit (keymap get subj-key)
              def subj (if (subj-hit is None) [subj-key] [subj-hit])
              if
                ((subj-hit is None) and
                    (not (starts-with "ent:" subj-key))
                )
                [def issue
                    (KgSchema.mk-issue
                        {id:(KgId.issue-id "kg_unknown_subject" subj-key
                              `assertion subject ${subj-key} is not a known entity key`
                          )
                          severity:"error"
                          rule:"kg_unknown_subject"
                          target_kind:"assertion"
                          target_id:subj-key
                          message:`assertion rejected: subject ${subj-key} matches no candidate entity key and is not an ent: id`
                          suggested_correction:none
                          automatic_correction_safe:false
                        }
                    )
                    KgUtil.as-map
                    {assertions:asts issues:(push issue issues)}
                ]
                [def object
                    (ingest-object (get-or cand "object" {}) keymap)
                  def evidence
                    (each ([ev] => [ingest-evidence ev])
                        (get-or cand "evidence" [])
                    )
                  if ((evidence size) eq 0)
                    [def issue
                        (KgSchema.mk-issue
                            {id:(KgId.issue-id "kg_no_provenance" subj
                                  `assertion ${subj} ${get-or cand "predicate" ""} has no evidence`
                              )
                              severity:"error"
                              rule:"kg_no_provenance"
                              target_kind:"assertion"
                              target_id:subj
                              message:`assertion rejected: ${subj} ${get-or cand "predicate" ""} carries no evidence record`
                              suggested_correction:"attach at least one evidence entry pointing at a listed source"
                              automatic_correction_safe:false
                            }
                        )
                        KgUtil.as-map
                        {assertions:asts issues:(push issue issues)}
                    ]
                    [def built
                        (KgAst.build-assertion
                            {subject_id:subj
                              predicate:(get-or cand "predicate" "")
                              object:object
                              evidence:evidence
                              confidence:(get-or cand "confidence" 1.0)
                              status:(get-or cand "status" "asserted")
                              valid_from:(get-or cand "valid_from" none)
                              valid_to:(get-or cand "valid_to" none)
                              recorded_at:(get-or cand "recorded_at" recorded_at)
                              rule:(get-or cand "rule" none)
                            }
                        )
                        KgUtil.as-map
                        {assertions:(push built asts) issues:issues}
                    ]
                ]
            ])
        (get-or raw "assertions" []) {assertions:[] issues:[]}
    )
    KgUtil.as-map
    {sources:sources
      entities:(folded get "entities")
      assertions:(ast-folded get "assertions")
      issues:(flatten [(folded get "issues") (ast-folded get "issues")])
      keymap:keymap
    }
]]

# ---- adapters -----------------------------------------------------------

# Adapt tabular rows (a list of {col: value} maps, as IO.read returns
# for csv/tsv with a header) into a candidate bundle.
#
# spec shape:
#   { source: <candidate source map — must carry id>
#     entity: { type:"Person" label_col:"name"
#               alias_cols? [..] external_id_cols? {scheme: col}
#               attribute_cols? [..] }
#     assertions: [ {predicate object_kind:"literal" value_col
#                    datatype? unit?}
#                   {predicate object_kind:"entity" entity_col
#                    entity_type?} ] }
# An `entity` object column names ANOTHER row value that becomes its own
# candidate entity of entity_type (default "Other").
def rows-to-candidates fn [[rows:List spec:Map] [Map] [
  def src (spec get "source")
  def src-id (src get "id")
  def espec (spec get "entity")
  def aspecs (get-or spec "assertions" [])
  def etype (get-or espec "type" "Other")
  def label-col (get-or espec "label_col" "")
  def per-row
    (each
        ([i] => [
              def row (rows get i)
              def label (convert String (get-or row label-col ""))
              def key `${src-id}:row-${convert String i}`
              def evidence
                [(KgUtil.as-map
                        {source:src-id
                          locator:`row ${convert String i}`
                          quote:(KgId.canon-of row)
                          extraction_method:"direct_record"
                          extractor:"kg-ingest/rows"
                        }
                    )
                ]
              def main
                {key:key
                  type:etype
                  label:label
                  aliases:(each ([c] => [convert String (get-or row c "")])
                      (get-or espec "alias_cols" [])
                  )
                  external_ids:(fold
                      ([kv acc] => [ acc set (kv get 0)
                              (convert String
                                  (get-or row (kv get 1) "")
                              )
                          ])
                      (StructUtil.items
                          (get-or espec "external_id_cols" {})
                      )
                      {}
                  )
                  attributes:(fold
                      ([c acc] => [acc set (c) (get-or row c none)])
                      (get-or espec "attribute_cols" []) {}
                  )
                }
              def extra
                (fold
                    ([aspec acc] => [
                          if
                            ((get-or aspec "object_kind" "") eq
                                "entity"
                            )
                            [def target
                                (convert String
                                    (get-or row
                                        (get-or aspec "entity_col" "")
                                        ""
                                    )
                                )
                              if (target eq "") [acc]
                                [push
                                    {key:`${key}-${get-or aspec "entity_col" ""}`
                                      type:(get-or aspec "entity_type"
                                          "Other"
                                      )
                                      label:target
                                    }
                                    acc
                                ]
                            ]
                            [acc]
                        ])
                    aspecs []
                )
              def asts
                (fold
                    ([aspec acc] => [
                          if
                            ((get-or aspec "object_kind" "") eq
                                "entity"
                            )
                            [def target
                                (convert String
                                    (get-or row
                                        (get-or aspec "entity_col" "")
                                        ""
                                    )
                                )
                              if (target eq "") [acc]
                                [push
                                    {subject:key
                                      predicate:(get-or aspec "predicate"
                                          "related_to"
                                      )
                                      object:{kind:"entity"
                                        entity:`${key}-${get-or aspec "entity_col" ""}`
                                      }
                                      evidence:evidence
                                    }
                                    acc
                                ]
                            ]
                            [def v
                                (get-or row
                                    (get-or aspec "value_col" "") none
                                )
                              if (v is None) [acc]
                                [push
                                    {subject:key
                                      predicate:(get-or aspec "predicate"
                                          "has_attribute"
                                      )
                                      object:{kind:"literal"
                                        value:v
                                        datatype:(get-or aspec "datatype"
                                            "String"
                                        )
                                      }
                                      evidence:evidence
                                    }
                                    acc
                                ]
                            ]
                        ])
                    aspecs []
                )
                KgUtil.as-map
                {entities:(push main extra) assertions:asts}
            ])
        (iota (rows size))
    )
    KgUtil.as-map
    {sources:[src]
      entities:(flatten (each [dot entities] per-row))
      assertions:(flatten (each [dot assertions] per-row))
    }
]]

# Re-ingest an existing boru-kg/1 bundle (output contract) as candidates:
# ids are kept verbatim (they are already deterministic and canonical).
def bundle-to-candidates fn bundle:Map Map [
  KgUtil.as-map
    {sources:(get-or bundle "sources" [])
      entities:(each
          ([e] => [ KgUtil.as-map
                  {key:e.id
                    type:e.type
                    label:e.label
                    aliases:e.aliases
                    external_ids:e.external_ids
                    attributes:e.attributes
                    status:e.status
                  }
              ])
          (get-or bundle "entities" [])
      )
      assertions:(each
          ([a] => [ KgUtil.as-map
                  {subject:a.subject_id
                    predicate:a.predicate
                    object:(if (KgSchema.is-entity-ref a.object)
                        [(KgUtil.as-map
                                {kind:"entity"
                                  entity:a.object.entity_id
                                }
                            )
                        ]
                        [a.object]
                    )
                    evidence:(each
                        ([ev] => [ KgUtil.as-map
                                {source:ev.source_id
                                  locator:ev.locator
                                  quote:ev.quote
                                  extraction_method:ev.extraction_method
                                  extractor:ev.extractor
                                }
                            ])
                        a.evidence
                    )
                    confidence:a.confidence
                    status:a.status
                    valid_from:a.valid_from
                    valid_to:a.valid_to
                    rule:a.rule
                    recorded_at:a.recorded_at
                  }
              ])
          (get-or bundle "assertions" [])
      )
    }
]

export "KgIngest" {
  prune-external-ids:prune-external-ids/v
  ingest-source:ingest-source/v
  ingest-entity:ingest-entity/v
  ingest-object:ingest-object/v
  ingest-evidence:ingest-evidence/v
  ingest-bundle:ingest-bundle/v
  rows-to-candidates:rows-to-candidates/v
  bundle-to-candidates:bundle-to-candidates/v
}
