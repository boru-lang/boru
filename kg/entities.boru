# entities.boru — pure helpers over the entity list.
#
# Entities are immutable KgEntity records (schema.boru); every transform
# here returns new values. Merges are NON-destructive: the superseded
# entity is kept with status "merged" and attributes.merged_into pointing
# at the canonical id, so every merge stays reversible and every source
# alias survives.

import "boru:struct-util"
import "./util.boru"
import "./schema.boru"

def KgEntity KgSchema.KgEntity

# id -> entity index.
def index-by-id fn entities:List Map [
  fold ([e acc] => [acc set (e.id) e]) entities {}
]

def find-by-id fn [[entities:List id:String] [Any] [
  def hits (filter [dot id eq id] entities)
  if ((hits size) gt 0) [hits get 0] [none]
]]

# Follow a merged entity to its canonical id. Merge chains are short
# (a loser points at its winner, which may itself have lost a later
# merge), so the chase is BOUNDED at 8 hops — never an unbounded walk.
def canonical-id fn [[index:Map id:String] [String] [
  fold
    ([step cur] => [
          def e (index get cur)
          if (e is None) [cur]
            [def tgt (e.attributes get "merged_into")
              if (tgt is None) [cur] [tgt]
            ]
        ])
    (iota 8) id
]]

# Distinct sorted string list.
def distinct-sorted fn xs:List List [
  sort
    (fold
        ([x acc] => [
              if (((filter [eq x] acc) size) gt 0) [acc] [push x acc]
            ])
        xs []
    )
]

# Merge `loser` into `winner` (already decided by resolve.boru):
#   - winner keeps its label; gains the loser's label + aliases as aliases
#   - external_ids union (every loser value survives; scheme conflicts
#     are ruled out before an automatic merge is allowed)
#   - attributes union (winner wins on shared keys)
#   - loser -> status "merged", attributes.merged_into = winner id
# Returns {winner loser}.
def merge-pair fn [[winner:Map loser:Map] [Map] [
  def aliases
    (filter [neq winner.label]
        (distinct-sorted
            (flatten [winner.aliases (push loser.label loser.aliases)])
        )
    )
  def new-winner
    (make KgEntity
        {id:winner.id
          type:winner.type
          label:winner.label
          normalized_label:winner.normalized_label
          aliases:aliases
          external_ids:(StructUtil.merge loser.external_ids winner.external_ids)
          attributes:(StructUtil.merge loser.attributes winner.attributes)
          status:winner.status
        }
    )
  def new-loser
    (make KgEntity
        {id:loser.id
          type:loser.type
          label:loser.label
          normalized_label:loser.normalized_label
          aliases:loser.aliases
          external_ids:loser.external_ids
          attributes:(loser.attributes set merged_into winner.id)
          status:"merged"
        }
    )
    KgUtil.as-map {winner:new-winner loser:new-loser}
]]

# Unify entities that share one deterministic id (the same record
# arriving from different candidate bundles): the first occurrence wins
# and later duplicates fold in via merge-pair (their labels, aliases,
# external ids, and attributes survive on the winner).
def unify-by-id fn entities:List List [
  fold
    ([e acc] => [
          def existing (filter [dot id eq e.id] acc)
          if ((existing size) gt 0)
            [def unified (merge-pair (existing get 0) e) each
                ([x] => [if (x.id eq e.id) [unified get "winner"] [x]])
                acc
            ]
            [push e acc]
        ])
    entities []
]

# Drop EXACT duplicates: a record whose id and full content deep-equal
# an already-kept record is the same object arriving again (overlapping
# candidate bundles, a re-ingested graph) — corroboration, not a
# duplicate-id violation. A record that shares an id but DIFFERS in
# content is kept, so validation still reports the genuine
# duplicate-id inconsistency instead of silently picking a winner.
def dedupe-identical fn xs:List List [
  fold
    ([x acc] => [
          def seen
            (((filter ([y] => [(y.id eq x.id) and (y deq x)])
                        acc
                    )
                    size
                )
                gt 0
            )
          if seen [acc] [push x acc]
        ])
    xs []
]

export "KgEnt" {
  index-by-id:index-by-id/v
  find-by-id:find-by-id/v
  canonical-id:canonical-id/v
  unify-by-id:unify-by-id/v
  dedupe-identical:dedupe-identical/v
  distinct-sorted:distinct-sorted/v
  merge-pair:merge-pair/v
}
