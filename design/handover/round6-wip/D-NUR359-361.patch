diff --git a/compiler/go/restep_tail.go b/compiler/go/restep_tail.go
new file mode 100644
index 000000000..861fffcd1
--- /dev/null
+++ b/compiler/go/restep_tail.go
@@ -0,0 +1,98 @@
+package compiler
+
+import (
+	core "github.com/boru-lang/boru/core/go"
+)
+
+// The RUN AT A STOP (SigRef.ReStepTail, NUR359). A computed `do` body's run
+// seated as data (SigRef.DynBodyPlain) that holds a fn value is re-stepped
+// by the interpreter where the `do` stood: the fn collects forward over the
+// tokens after it, then from the stack beneath it. Seated as data, the run
+// cannot do that, so the VM re-steps it in place — exactly, when every value
+// the fn could collect is the run's own. The run's stack side the VM bounds
+// at run time (vm_do_restep.go's tailReSteps: each fn's widest signature
+// fits in what the run leaves beneath it). The forward side is the tape
+// after the run, which only the program's tokens know: runAtStop proves it
+// holds nothing to collect — the `do` and its one body operand are the last
+// tokens of a body whose end is a collection stop on the interpreter's tape.
+
+// runAtStop reports whether the `do` call seq is the last statement of a
+// body whose end stops a collection: the unit's own body (a fn frame's tail
+// markers, or the program's end at the root), or a loop's body or a branch
+// arm (stopBodyTok). The word is the body's last token (its body operand
+// beneath it) or its last but one, the body operand written right after it —
+// a paren, a literal list, or a read of a def-bound value, each of which the
+// word's forward-first collection takes.
+func (lw *lowerer) runAtStop(seq int, c *emitCall) bool {
+	body := lw.sourceBody()
+	if lw.es == nil || c.word != "do" || len(c.ops) != 1 || len(body) == 0 {
+		return false
+	}
+	path := tokenPath(body, c.pos)
+	if len(path) == 0 {
+		return false
+	}
+	toks, parent := body, []core.Value(nil)
+	for _, at := range path[:len(path)-1] {
+		parent = toks
+		toks, _ = nestedToks(toks[at])
+	}
+	at := path[len(path)-1]
+	if !core.IsWord(toks[at]) || toks[at].Pos() != c.pos {
+		return false
+	}
+	switch {
+	case at == len(toks)-1:
+	case at == len(toks)-2 && lw.es.bodyOperandAfter(seq, toks, at):
+	default:
+		return false
+	}
+	if len(path) == 1 {
+		// The program's end, a fn frame's tail (a named fn's or a lambda's),
+		// or a callback's end: a code body whose word collects its residual
+		// (each, fold, …) runs it on its own. A body whose word hands its
+		// whole residual back to the caller's tape (`do [...]`,
+		// residualToCaller) is spliced where the tokens after that word
+		// follow it.
+		return lw.landingRoot || (lw.isFnUnit && lw.rec != nil && (lw.frameTail || (lw.rec.closure && !lw.rec.residualToCaller)))
+	}
+	return stopBodyTok(parent, path[len(path)-2])
+}
+
+// stopBodyTok reports whether the literal list at parent[bt] is a body whose
+// end stops a collection on the interpreter's tape: a `for` / `while` loop's
+// body (`for n [body]`, `while [c] [body]` — the loop's continuation marker
+// follows it) or an `if`'s arm (`if c [then] [else]` — the arm runs on its
+// own, a fn left at its end parked in its results).
+func stopBodyTok(parent []core.Value, bt int) bool {
+	if bt < 2 || !literalListTok(parent[bt]) {
+		return false
+	}
+	w := wordName(parent[bt-2])
+	if w == "for" || w == "while" || w == "if" {
+		return true
+	}
+	return bt >= 3 && wordName(parent[bt-3]) == "if" && literalListTok(parent[bt-1])
+}
+
+// wordName is the name of the word token v, or "".
+func wordName(v core.Value) string {
+	w, err := core.AsWord(v)
+	if err != nil {
+		return ""
+	}
+	return w.Name
+}
+
+// bodyOperandAfter reports whether the token after the word at toks[at] is
+// the call seq's one operand, written there: a paren or a literal list —
+// values the word's forward-first collection always takes — or a read whose
+// site is that token.
+func (es *EmitState) bodyOperandAfter(seq int, toks []core.Value, at int) bool {
+	next := toks[at+1]
+	if core.IsParenExpr(next) || literalListTok(next) {
+		return true
+	}
+	sites := es.argSites[seq]
+	return len(sites) == 1 && sites[0].seq < 0 && sites[0].pos.Row > 0 && bodyTokenContaining(toks, sites[0].pos) == at+1
+}
