+}
+
+// reStepSeated is a re-step's results where the program seats them: a count
+// the program does not hold (SigRef.ReStepOut) is a designed defer.
+func reStepSeated(reg *core.Registry, s *compiler.SigRef, out []core.Value, debug []core.SrcPos, pc int) ([]core.Value, error) {
 	if s.ReStepOut >= 0 && len(out) != s.ReStepOut {
 		return nil, vmDefer(reg, debug, pc, "vm:do-restep", s.Word+"'s re-stepped results are "+strconv.Itoa(len(out))+" value(s) where the program seats "+strconv.Itoa(s.ReStepOut)+" (NUR317); the compiled runtime cannot execute it")
 	}
 	return out, nil
 }
 
+// tailReStep re-steps in place a computed run that lands at a collection
+// stop (SigRef.ReStepTail) and that tailReSteps admitted: each fn it holds
+// takes an argument, and the interpreter's step loop dispatches it where
+// the `do` stood, collecting forward over the run's later values — the tape
+// after the run holds nothing it collects — and from the stack beneath it,
+// which its widest signature never reaches past the run's own values. So
+// the island stepping the run alone is the interpreter's own re-step: its
+// results, its raise (a no-match, or the fn's body's), or the break /
+// continue the fn raised for the enclosing loop to take (NUR359). A value
+// the re-step left that the tape would step again — a fn that matched
+// nothing parks as data on the island, where the interpreter's frame tail
+// or a later arrival acts on it — is the plain seat's designed defer.
+func (vc *vmContext) tailReStep(reg *core.Registry, s *compiler.SigRef, results []core.Value, debug []core.SrcPos, pc int) ([]core.Value, error) {
+	out, err := runIslandResolved(reg, nil, append([]core.Value(nil), results...))
+	if err != nil {
+		return nil, stampAt(err, debug, pc, reg)
+	}
+	if flowPending(reg) {
+		return out, nil
+	}
+	if err := checkDynBodyPlain(reg, s.Word, out, debug, pc); err != nil {
+		return nil, err
+	}
+	return reStepSeated(reg, s, out, debug, pc)
+}
+
+// tailReSteps reports whether a computed run a plain seat refuses
+// (dynBodyPlainRefuses) re-steps exactly on its own where it lands at a
+// collection stop (SigRef.ReStepTail): every value among it the step loop
+// dispatches is a boru fn whose widest signature fits in the values the run
+// has surely left beneath it when the step reaches it. Walking the run, a
+// plain value adds one — unless a fn before it may claim it forward — and a
+// fn takes at most its widest count from beneath, claims at most as many
+// values after it, and leaves at least its narrowest declared result count
+// (a return contract the frame enforces: a run that breaks it raises on
+// both lanes before any later dispatch). So no signature any dispatch tries
+// reads a value beneath the run, and the run's own values are the
+// interpreter's.
+func tailReSteps(reg *core.Registry, results []core.Value) bool {
+	// A tape-coupled token (a word, a splice, a marker) is the screen's to
+	// refuse: what it steps to is no value the walk can bound.
+	if !dynBodyPlainRefuses(results) || tapeCoupled(results) {
+		return false
+	}
+	beneath, claimable := 0, 0
+	for _, v := range results {
+		if !dynBodyValueReSteps(v) {
+			if claimable > 0 {
+				claimable--
+				continue
+			}
+			beneath++
+			continue
+		}
+		in, out, ok := boruSigBounds(reg, v)
+		if !ok || in > beneath {
+			return false
+		}
+		beneath, claimable = beneath-in+out, in
+	}
+	return true
+}
+
+// boruSigBounds is the widest signature's argument count (in) and the
+// narrowest declared result count (out; 0 where a signature declares none)
+// of a boru fn value whose own signatures its dispatch at the pointer
+// matches (a registry-local fn or a lambda: execFnDefLiteral's own-sig arm),
+// each a boru body — its results park where they land, never stepped again
+// by the dispatch — and none reading the whole stack. ok is false for
+// anything else the step loop dispatches.
+func boruSigBounds(reg *core.Registry, v core.Value) (in, out int, ok bool) {
+	fd, isFn := v.Data.(core.FnDefInfo)
+	if !isFn || !core.FnValueDispatchesAtPointer(v) || len(fd.Signatures) == 0 || core.FnHomeForeign(reg, &fd) {
+		return 0, 0, false
+	}
+	out = -1
+	for i := range fd.Signatures {
+		sig := &fd.Signatures[i]
+		if sig.Fallback {
+			continue
+		}
+		if _, boru := sig.Impl.(*core.BoruImpl); !boru || sig.FullStack() {
+			return 0, 0, false
+		}
+		in = max(in, sig.TotalArgs())
+		if out < 0 || len(sig.Returns) < out {
+			out = len(sig.Returns)
+		}
+	}
+	return in, max(out, 0), true
+}
+
 // takesArgsAtPointer reports whether v is a value the step loop dispatches
 // that may take an argument: anything it dispatches but a fn whose every
 // signature takes none.
