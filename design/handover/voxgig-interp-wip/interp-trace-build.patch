+++ b/core/go/interp_entry.go
@@ -1,6 +1,9 @@
 package core
 
 import (
+	"fmt"
+	"os"
+	"runtime"
 	"strings"
 	"sync/atomic"
 )
@@ -168,6 +171,28 @@ func (r *Registry) InheritObserveHooks(parent *Registry) {
 // noteInterp emits one interpreter-entry observation when the hook is armed.
 // Nil-safe on both the registry and the holder.
 func (r *Registry) noteInterp(seam string) {
+	if r != nil && os.Getenv("BORU_INTERP_TRACE") != "" {
+		att := r.interpAttribution
+		check := r.analysisActive() || strings.HasPrefix(att, "check:")
+		if !check && att == "" {
+			pcs := make([]uintptr, 12)
+			n := runtime.Callers(3, pcs)
+			fr := runtime.CallersFrames(pcs[:n])
+			var chain []string
+			for {
+				f, more := fr.Next()
+				name := f.Function
+				if i := strings.LastIndex(name, "/"); i >= 0 {
+					name = name[i+1:]
+				}
+				chain = append(chain, name)
+				if !more || len(chain) >= 8 {
+					break
+				}
+			}
+			fmt.Fprintf(os.Stderr, "INTERP\t%s\t%s\n", seam, strings.Join(chain, " < "))
+		}
+	}
 	if r == nil || r.interpHook == nil {
 		return
 	}
