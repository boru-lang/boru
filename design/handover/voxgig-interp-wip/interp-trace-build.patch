 }
+
+func traceIslandTokens(site string, tokens []core.Value) {
+	if os.Getenv("BORU_INTERP_TRACE") == "" {
+		return
+	}
+	pos := ""
+	var parts []string
+	for i, t := range tokens {
+		p := t.Pos()
+		if pos == "" && p.Row > 0 {
+			pos = fmt.Sprintf("%d:%d", p.Row, p.Col)
+		}
+		if i < 12 {
+			parts = append(parts, t.String())
+		}
+	}
+	fmt.Fprintf(os.Stderr, "ISLAND\t%s\t%s\t%s\n", site, pos, strings.Join(parts, " "))
+}
